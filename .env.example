OPENTOFU_VERSION=1.13.9

# Vault
VAULT_VERSION=2.1.2
VAULT_PORT=8200
VAULT_AUTH_PROXY_PORT=18200

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_PASSWORD=password

# Redpanda
REDPANDA_PORT=19092
REDPANDA_CONSOLE_PORT=18080

# Gateway
ENVOY_VERSION=v1.39.3
PROTOBUF_IMAGE=ghcr.io/dz-market/protobuf:latest

ENVOY_HTTP_PORT=8080
ENVOY_ADMIN_PORT=9901

ENVOY_AUTH_HOST=svc-auth
ENVOY_AUTH_PORT=50051

ENVOY_USER_HOST=svc-user
ENVOY_USER_PORT=50052

# Auth
AUTH_IMAGE=ghcr.io/dz-market/svc-auth:latest
AUTH_MIGRATE_IMAGE=ghcr.io/dz-market/svc-auth-migrate:latest
AUTH_GRPC_PORT=50051
AUTH_GRPC_REFLECTION=true

VAULT_ADDR=http://vault-proxy-auth:8200

AUTH_POSTGRES_HOST=postgres
AUTH_POSTGRES_DB=auth
AUTH_POSTGRES_USER=svc_auth
AUTH_POSTGRES_PASSWORD=password

AUTH_KAFKA_BROKERS=redpanda:9092

# User
USER_IMAGE=ghcr.io/dz-market/svc-user:latest
USER_MIGRATE_IMAGE=ghcr.io/dz-market/svc-user-migrate:latest
USER_GRPC_PORT=50052
USER_GRPC_REFLECTION=true

AUTH_SERVICE_ADDR=svc-auth:50051

USER_POSTGRES_HOST=postgres
USER_POSTGRES_DB=user
USER_POSTGRES_USER=svc_user
USER_POSTGRES_PASSWORD=password

USER_KAFKA_BROKERS=redpanda:9092